# Copy to .env. Leave optional provider fields blank for local sample practice.
# Requires Node.js 24+. Never commit .env or real API keys.
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=.local/ielts.sqlite
# Required in production: a securely generated random string of at least 32 characters.
SESSION_SECRET=
# Sample learner sign-in is enabled in development; explicitly opt in in production.
ALLOW_DEMO=false

# OpenAI: IELTS_OPENAI_API_KEY also works as a cloud secret target.
IELTS_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_MS=60000

# Text-to-dialogue: choose actual voice IDs from your ElevenLabs account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BRITISH_ID=
ELEVENLABS_VOICE_AUSTRALIAN_ID=
ELEVENLABS_VOICE_AMERICAN_ID=

# Optional acoustic pronunciation assessment for recorded 16 kHz WAV.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_LANGUAGE=en-US

# Optional Supabase Auth + PostgreSQL. Apply supabase/migrations SQL first.
# Without these two fields, authentication and persistence use local SQLite.
SUPABASE_URL=
SUPABASE_ANON_KEY=
